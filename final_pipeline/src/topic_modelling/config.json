{
  "embedding_model": "Alibaba-NLP/gte-base-en-v1.5",
  "umap": {
    "n_neighbors": 30,
    "n_components": 5,
    "min_dist": 0.05,
    "random_state": 42
  },
  "hdbscan": {
    "min_cluster_size": 2,
    "min_samples": 2,
    "gen_min_span_tree": true,
    "prediction_data": true
  },
  "vectorizer": {
    "ngram_range": [1, 2],
    "stop_words": "english",
    "additional_stopwords": [
      "wa",
      "et",
      "et al",
      "cid",
      ",",
      ".",
      ":",
      "a",
      "ai",
      "and",
      "are",
      "be",
      "can",
      "for",
      "in",
      "is",
      "it",
      "of",
      "on",
      "or",
      "s",
      "that",
      "the",
      "this",
      "to",
      "with",
      "’",
      "an",
      "at",
      "but",
      "by",
      "from",
      "more",
      "not",
      "an",
      "at",
      "by",
      " from",
      "ha",
      "have",
      "not",
      "one",
      "which",
      "will",
      "all",
      "been",
      "but",
      "computer",
      "if",
      "code",
      "say"
    ]
  },
  "bertopic": {
    "top_n_words": 10,
    "language": "english",
    "calculate_probabilities": true,
    "verbose": true
  },
  "multi_topic_assignment": {
    "enabled": true,
    "probability_threshold": 0.05
  },
  "preprocessing": {
    "remove_headers": true,
    "normalize_whitespace": true,
    "remove_stopwords": true,
    "lemmatize": true,
    "min_text_length": null
  }
}
