{
  "embedding_model": "Alibaba-NLP/gte-base-en-v1.5",
  "umap": {
    "n_neighbors": 10,
    "n_components": 10,
    "min_dist": 0.05,
    "random_state": 42
  },
  "hdbscan": {
    "min_cluster_size": 7,
    "min_samples": 3,
    "gen_min_span_tree": true,
    "prediction_data": true
  },
  "vectorizer": {
    "ngram_range": [
      1,
      2
    ],
    "stop_words": "english",
    "additional_stopwords": [
      "http",
      "https",
      "amp",
      "com",
      "www"
    ]
  },
  "bertopic": {
    "top_n_words": 10,
    "language": "english",
    "calculate_probabilities": true,
    "verbose": true
  },
  "multi_topic_assignment": {
    "enabled": false,
    "probability_threshold": 0.2
  },
  "preprocessing": {
    "remove_headers": true,
    "normalize_whitespace": true,
    "remove_stopwords": true,
    "lemmatize": true,
    "min_text_length": null
  }
}